<?xml version="1.0" encoding="utf-8" ?>
<configuration>

  <connectionStrings>
    <add name="PeppolMOFCon" providerName="System.Data.SqlClient" connectionString="Data Source=192.168.191.6;Initial Catalog=PeppolMOF;User ID=sesamisvc;Pwd=S3s4m1@516;"/>
  </connectionStrings>

  <appSettings>
    <!-- ===================================================== -->
    <!-- REPORT SETTINGS                                      -->
    <!-- ===================================================== -->

    <!-- Folder where generated Excel reports will be stored -->
    <add key="ReportOutputPath" value="F:\Test\MOF" />

    <!-- Excel file name -->
    <add key="ReportFileName" value="Daily_PO_Transaction_Report_{0:yyyyMMddHHmmss}.xlsx" />

    <!-- ===================================================== -->
    <!-- EMAIL SETTINGS                                       -->
    <!-- ===================================================== -->

    <add key="EmailEnabled" value="true" />
    <add key="EmailFrom" value="zameer@sesami.com" />

    <!-- Multiple email addresses separated by ; -->
    <add key="EmailTo" value="zameer@company.com;lakshman@company.com" />
    <add key="EmailCc" value="zameer@sesami.com,lakshman@sesami.com" />
    <add key="SmtpHost" value="192.168.193.29" />
    <add key="SmtpPort" value="25" />
    <add key="EnableSsl" value="false" />

    <!-- true = Windows/service account credentials -->
    <!-- false = Username/Password below -->
    <add key="UseDefaultCredentials" value="true" />
    <add key="SmtpUsername" value="" />
    <add key="SmtpPassword" value="" />


    <!-- ===================================================== -->
    <!-- EMAIL CONTENT                                        -->
    <!-- ===================================================== -->

    <add key="EmailSubject" value="Daily PO Transaction Report - {0:yyyy-MM-dd}" />

    <add key="EmailBody" value="Dear All,&lt;br/&gt;&lt;br/&gt;Please find attached the Daily PO Transaction Report for {0:yyyy-MM-dd}.&lt;br/&gt;&lt;br/&gt;The report contains PO original, variation, cancellation and balance transactions received from GeBIZ, Cumulus and NFS during the previous day.&lt;br/&gt;&lt;br/&gt;Regards,&lt;br/&gt;SESAMi" />


    <!-- ===================================================== -->
    <!-- SQL QUERY                                            -->
    <!-- ===================================================== -->

      <add key="SqlQuery" value="SELECT TOP 3 HubId AS SourceSystem, CreatedDate AS ReceivedDate, LastUpdatedDate AS SentDate, StatusDate AS PODate, OrderCode AS PONumber, OrderTypeStatus AS POType, BuyerOrganisationCode AS SenderPeppolID, BuyerOrganisationName AS SenderLegalName, SupplierCode AS ReceiverPeppolID, SupplierName AS ReceiverLegalName,(CASE WHEN InterfaceStatus='APIFailed' THEN APIMessage ELSE InterfaceMessage END) Remarks FROM [PeppolMOF].[dbo].[TblPOHeader] WHERE cast(CreatedDate as date)&lt;=cast(DATEADD(DAY,-1,GETDATE()) as Date) UNION ALL SELECT TOP 3 'NFS' AS SourceSystem, CreatedDate AS ReceivedDate, LastUpdatedDate AS SentDate, IssueDate AS PODate, PONumber AS PONumber, 'POBalance' AS POType, REPLACE(BuyerPeppolID, '0195:', '') AS SenderPeppolID, BuyerName AS SenderLegalName, VendorID AS ReceiverPeppolID, VendorName AS ReceiverLegalName,(CASE WHEN InterfaceStatus='APIFailed' THEN APIMessage ELSE InterfaceMessage END) Remarks FROM [PeppolMOF].[dbo].[TblOBHeader] WHERE cast(CreatedDate as date)&lt;=cast(DATEADD(DAY,-1,GETDATE()) as Date) ORDER BY ReceivedDate;" />


    <!-- ===================================================== -->
    <!-- LOGGING                                               -->
    <!-- ===================================================== -->

    <add key="LogPath" value="F:\Test\MOF\Logs" />

  </appSettings>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
</configuration>